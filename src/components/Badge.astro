---
interface Props {
  text: string;
  color?: 'green' | 'cyan' | 'yellow' | 'purple' | 'red' | 'orange';
}
const { text, color = 'cyan' } = Astro.props;
---
<span class={`badge badge-${color}`}>{text}</span>

<style>
  .badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid var(--border);
    white-space: nowrap;
  }
  .badge { color: var(--muted); background: var(--bg-card); }
</style>
