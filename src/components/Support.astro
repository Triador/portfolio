---
import type { Language } from '../data/projects';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = (ru: string, en: string) => lang === 'ru' ? ru : en;
const wallet = 'UQCVRBwdjVFDj1XZa412b0y1H8seJjx9tWLCyza_qorVau36';
const card = '5536914115073797';
const methods = [
  { label: 'USDT · TON', value: wallet, copyLabel: t('Скопировать адрес USDT в сети TON', 'Copy the USDT address on TON'), wallet: true },
  { label: t('Т-Банк', 'T-Bank'), value: card, copyLabel: t('Скопировать номер карты Т-Банка', 'Copy the T-Bank card number'), wallet: false },
];
---
<details class="support" data-support>
  <summary aria-label={t('Угостить кофе', 'Buy me a coffee')}>
    <svg class="coffee-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 8h1a3 3 0 0 1 0 6h-1M4 8h13v7a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4ZM3 22h16M7 5c-2-2 2-2 0-4M12 5c-2-2 2-2 0-4" /></svg>
    <span class="full-label">{t('Угостить кофе', 'Buy me a coffee')}</span>
    <span class="short-label">{t('На кофе', 'Coffee')}</span>
  </summary>
  <div class="payment-panel">
    <div class="payment-methods">
      {methods.map(method => (
        <div class="payment-method" data-method>
          <div class="method-details">
            <div class="method-heading"><span>{method.label}</span><span class="copy-feedback" aria-hidden="true">{t('Скопировано', 'Copied')}</span></div>
            <code class:list={['method-value', { 'wallet-address': method.wallet }]}>{method.wallet ? <>{wallet.slice(0, 24)}<wbr />{wallet.slice(24)}</> : card.match(/.{4}/g)?.join(' ')}</code>
          </div>
          <button type="button" class="copy-button" data-copy={method.value} data-copy-label={method.copyLabel} data-copied-label={t('Скопировано', 'Copied')} aria-label={method.copyLabel} title={method.copyLabel} hidden>
            <svg class="copy-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="3" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>
            <svg class="check-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
          </button>
        </div>
      ))}
      <p class="copy-error" data-copy-error hidden>{t('Не удалось скопировать. Можно выделить реквизиты вручную.', 'Could not copy. You can select the details manually.')}</p>
    </div>
  </div>
  <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
</details>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-support]').forEach(support => {
    const status = support.querySelector<HTMLElement>('[data-copy-status]');
    const error = support.querySelector<HTMLElement>('[data-copy-error]');
    const timers = new Map<HTMLButtonElement, ReturnType<typeof setTimeout>>();

    document.addEventListener('pointerdown', event => {
      if (support.open && event.target instanceof Node && !support.contains(event.target)) support.open = false;
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && support.open) {
        support.open = false;
        support.querySelector('summary')?.focus();
      }
    });
    support.addEventListener('focusout', event => {
      if (support.open && event.relatedTarget instanceof Node && !support.contains(event.relatedTarget)) support.open = false;
    });

    support.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => {
      button.hidden = false;
      button.addEventListener('click', async () => {
        const method = button.closest<HTMLElement>('[data-method]');
        const value = button.dataset.copy;
        if (!method || !value) return;

        try {
          await navigator.clipboard.writeText(value);
          if (error) error.hidden = true;
          const previousTimer = timers.get(button);
          if (previousTimer) clearTimeout(previousTimer);
          method.dataset.state = 'copied';
          button.title = button.dataset.copiedLabel ?? '';
          button.setAttribute('aria-label', button.dataset.copiedLabel ?? '');
          if (status) status.textContent = `${method.querySelector('.method-heading > span')?.textContent}: ${button.dataset.copiedLabel}`;
          timers.set(button, setTimeout(() => {
            delete method.dataset.state;
            button.title = button.dataset.copyLabel ?? '';
            button.setAttribute('aria-label', button.dataset.copyLabel ?? '');
            timers.delete(button);
          }, 2400));
        } catch {
          if (error) error.hidden = false;
          if (status && error) status.textContent = error.textContent;
        }
      });
    });
  });
</script>

<style>
  .support { position: relative; flex-shrink: 0; }
  summary { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 10px 14px; cursor: pointer; list-style: none; white-space: nowrap; font-size: 12px; font-weight: 600; color: #714e35; background: #f7f1e7; border: 1px solid #e9dfcf; border-radius: 999px; transition: background .2s, border-color .2s; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: #efe1cd; border-color: #dcc4a6; }
  .support[open] summary { background: #eee2cd; border-color: #deccb0; color: #614229; }
  summary:focus-visible { outline: 2px solid #946744; outline-offset: 4px; }
  .coffee-icon { flex-shrink: 0; color: #915e35; }
  .short-label { display: none; }
  .payment-panel { position: absolute; top: calc(100% + 12px); left: 50%; z-index: 20; width: 360px; transform: translateX(-50%); filter: drop-shadow(0 12px 16px #46331b14) drop-shadow(0 0 1px #8e795744); }
  .payment-methods { padding: 4px 22px 12px; border-radius: 14px 14px 0 0; background: #fffdf7; mask: linear-gradient(#000 0 0) top / 100% calc(100% - 6px) no-repeat, conic-gradient(from -45deg at 50% 100%, #000 90deg, #0000 0) bottom / 12px 6px repeat-x; }
  .payment-method { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 20px 0; }
  .payment-method + .payment-method { border-top: 1px dashed #ded6c5; }
  .method-details { min-width: 0; }
  .method-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 12px; font-weight: 500; line-height: 1.5; color: #756b5d; }
  .copy-feedback { display: none; color: #247357; font-size: 11px; }
  .method-value { display: block; margin-top: 8px; font-family: 'Cascadia Code', Consolas, monospace; font-size: 16px; font-weight: 400; line-height: 1.65; color: #40382e; user-select: all; font-variant-numeric: tabular-nums; }
  .wallet-address { font-size: 12.5px; overflow-wrap: anywhere; }
  .copy-button { position: relative; display: grid; place-items: center; flex-shrink: 0; width: 44px; height: 44px; border: 0; border-radius: 50%; background: transparent; color: #82715b; cursor: pointer; transition: background .15s, color .15s; }
  .copy-button[hidden] { display: none; }
  .copy-button:hover { color: #614229; background: #eee5d5; }
  .copy-button:focus-visible { outline: 2px solid #946744; outline-offset: 1px; }
  .copy-button svg { grid-area: 1 / 1; }
  .check-icon { opacity: 0; }
  [data-state="copied"] .copy-feedback { display: inline; }
  [data-state="copied"] .check-icon { opacity: 1; }
  [data-state="copied"] .copy-icon { opacity: 0; }
  [data-state="copied"] .copy-button { color: #247357; background: #e5f1e9; }
  .copy-error { margin: 0; padding-bottom: 20px; font-size: 12px; line-height: 1.6; color: #a33d36; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 700px) {
    .support { position: static; }
    summary { padding-right: 11px; padding-left: 11px; }
    .payment-panel { top: calc(50% + 34px); right: 22px; left: auto; max-width: calc(100% - 44px); transform: none; }
    .payment-methods { padding-right: 18px; padding-left: 18px; }
    .wallet-address { font-size: 12px; }
  }
  @media (max-width: 360px) {
    summary { gap: 6px; padding-right: 9px; padding-left: 9px; }
    .full-label { display: none; }
    .short-label { display: inline; }
    .payment-methods { padding-right: 16px; padding-left: 16px; }
    .payment-method { gap: 8px; }
    .method-value:not(.wallet-address) { font-size: 14px; }
  }
</style>
