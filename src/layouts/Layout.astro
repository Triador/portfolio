---
interface Props { title: string; description?: string; }
const { title, description = 'Personal projects by triador.' } = Astro.props;
const lang = Astro.url.pathname.includes('/ru') ? 'ru' : 'en';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="build-revision" content={import.meta.env.PUBLIC_SITE_REVISION ?? 'local'} />
  <meta name="theme-color" content="#fafafa" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;650;700;750;800&display=swap" rel="stylesheet" />
</head>
<body><slot /></body>
</html>
<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  * { margin: 0; }
  :root {
    color-scheme: light; font-family: 'Manrope', Arial, sans-serif;
    --bg: #fafafa; --bg-card: #f0f1f2; --bg-hover: #e9eaec;
    --text: #17191c; --muted: #686d74; --border: #dfe1e4;
    --green: #247357; --cyan: #245e91; --yellow: #8b671b;
    --purple: #73539c; --red: #b04444; --orange: #9a5b28;
  }
  html { scroll-behavior: smooth; scroll-padding-top: 32px; }
  body { background: var(--bg); color: var(--text); font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; }
  button, a, summary { -webkit-tap-highlight-color: transparent; }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid #247357; outline-offset: 5px; }
  ::selection { background: #d7ecdf; color: #17191c; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
  .technical .container { max-width: 980px; margin: auto; padding: 0 28px; }
  .technical nav { max-width: 1180px; margin: auto; min-height: 96px; padding: 20px 28px; display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .technical .nav-logo { font-size: 24px; font-weight: 800; }
  .technical .blink, .technical .sep { display: none; }
  .technical .nav-links, .technical .lang-switch { display: flex; align-items: center; gap: 20px; font-size: 13px; }
  .technical .lang-switch { gap: 12px; }
  .technical .nav-links a { color: var(--muted); }
  .technical .lang-active { font-weight: 800; }
  .technical .page-header { padding: 64px 0 40px; }
  .technical .page-label { margin-bottom: 16px; font-size: 14px; color: var(--muted); }
  .technical .page-title { font-size: 48px; line-height: 1.15; font-weight: 750; margin-bottom: 20px; }
  .technical .page-sub { color: var(--muted); max-width: 640px; }
  .technical .section { padding-bottom: 64px; }
  .technical .block { margin-top: 40px; }
  .technical .block-title { font-size: 20px; font-weight: 650; margin-bottom: 20px; }
  .technical .tech-badges { display: flex; flex-wrap: wrap; gap: 10px; }
  .technical .page-footer { margin-top: 40px; }
  .technical .btn-secondary { display: inline-flex; min-height: 48px; align-items: center; border-bottom: 1px solid var(--border); }
  .technical footer { padding: 28px 0; border-top: 1px solid var(--border); color: var(--muted); font-size: 13px; }
  .technical .footer-inner { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .technical .muted { color: var(--muted); }
  .technical a:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 600px) {
    .technical nav { min-height: 80px; padding: 16px 22px; gap: 12px; }
    .technical .nav-links { gap: 14px; }
    .technical .nav-links > a:nth-child(2) { display: none; }
    .technical .container { padding: 0 22px; }
    .technical .page-header { padding-top: 32px; }
    .technical .page-title { font-size: 34px; }
  }
</style>
